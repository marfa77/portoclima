---
import "../styles/global.css";
import type { Locale } from "../lib/i18n";
import { t } from "../lib/i18n";
import { siteConfig } from "../data/site";
import JsonLd from "../components/JsonLd.astro";
import CookieNotice from "../components/CookieNotice.astro";
import LlmFactsCapsule from "../components/LlmFactsCapsule.astro";
import { getHomeAiDescription, getHomeLlmFacts } from "../lib/aeo";

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  /** Path for pt-PT hreflang (default: home) */
  alternatePt?: string;
  /** Path for en hreflang (default: /en/) */
  alternateEn?: string;
  /** When false, skip LocalBusiness JSON-LD (use on index/list pages with their own schema) */
  includeJsonLd?: boolean;
  /** Preload homepage hero — only for landing pages */
  preloadHero?: boolean;
  /** Override default home AEO description */
  aiDescription?: string;
  /** When false, skip LlmFactsCapsule (pages that inject their own) */
  includeLlmCapsule?: boolean;
  llmFacts?: string;
  llmCommercial?: string;
  llmDifferentiators?: string;
  aiCategory?: string;
}

const {
  locale,
  title,
  description,
  alternatePt = "/",
  alternateEn = "/en/",
  includeJsonLd = true,
  preloadHero = true,
  includeLlmCapsule = true,
  aiCategory = "porto-clima-service",
} = Astro.props;
const dict = t(locale);
const pageTitle = title ?? dict.meta.title;
const pageDesc = description ?? dict.meta.description;
const canonical = new URL(Astro.url.pathname, Astro.site);
const hreflangPt = new URL(alternatePt, Astro.site);
const hreflangEn = new URL(alternateEn, Astro.site);
const homeCapsule = getHomeLlmFacts(locale);
const aiDescription = Astro.props.aiDescription ?? getHomeAiDescription(locale);
const usingHomeCapsule = Astro.props.llmFacts == null;
const llmFacts = Astro.props.llmFacts ?? homeCapsule.facts;
const llmCommercial = Astro.props.llmCommercial ?? homeCapsule.commercial;
const llmDifferentiators =
  Astro.props.llmDifferentiators ?? (usingHomeCapsule ? homeCapsule.differentiators : undefined);
---

<!doctype html>
<html lang={locale === "pt" ? "pt-PT" : "en"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#f7f2ea" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta name="ai:description" content={aiDescription} />
    <meta name="ai:category" content={aiCategory} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="pt-PT" href={hreflangPt} />
    <link rel="alternate" hreflang="en" href={hreflangEn} />
    <link rel="alternate" hreflang="x-default" href={hreflangPt} />
    <link
      rel="alternate"
      type="text/plain"
      href={new URL("/llms.txt", Astro.site)}
      title="Information for LLMs and AI agents"
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/images/og.webp", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:image" content={new URL("/images/og.webp", Astro.site)} />
    <meta property="og:locale" content={locale === "pt" ? "pt_PT" : "en_GB"} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {preloadHero && (
      <link rel="preload" as="image" href="/images/hero.webp" type="image/webp" />
    )}

    {siteConfig.plausibleDomain && (
      <script
        defer
        data-domain={siteConfig.plausibleDomain}
        src="https://plausible.io/js/script.js"
      />
    )}
    {siteConfig.ga4Id && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${siteConfig.ga4Id}`} />
        <script is:inline define:vars={{ ga4Id: siteConfig.ga4Id }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          gtag("js", new Date());
          gtag("config", ga4Id);
        </script>
      </>
    )}

    {includeJsonLd && <JsonLd locale={locale} />}
  </head>
  <body class="antialiased body-mobile-pad">
    {includeLlmCapsule && (
      <LlmFactsCapsule facts={llmFacts} commercial={llmCommercial} differentiators={llmDifferentiators} />
    )}
    <slot name="header" />
    <main>
      <slot />
    </main>
    <slot name="footer" />
    <slot name="sticky" />
    <CookieNotice locale={locale} />

    <script is:inline>
      (function () {
        const params = new URLSearchParams(window.location.search);
        ["utm_source", "utm_medium", "utm_campaign", "utm_content"].forEach((k) => {
          const v = params.get(k);
          if (v) sessionStorage.setItem(k, v);
        });
      })();
    </script>
  </body>
</html>
